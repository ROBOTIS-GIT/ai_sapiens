<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="k1_imu_system" params="use_mock_hardware:=^|false mock_sensor_commands:=^|false">
    <ros2_control name="k1_imu" type="system" is_async="true">
      <properties>
        <async scheduling_policy="synchronized" print_warnings="false"/>
      </properties>
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">${mock_sensor_commands}</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
          <param name="port_name">e2d2udp:192.168.10.1:5005</param>
          <param name="baud_rate">6000000</param>
          <param name="error_timeout_ms">500</param>
          <param name="dynamixel_model_folder">/param/dxl_model</param>
          <param name="number_of_joints">0</param>
          <param name="number_of_transmissions">0</param>
          <param name="disable_torque_at_init">true</param>
          <param name="dynamixel_state_pub_msg_name">k1_imu/dxl_state</param>
          <param name="get_dynamixel_data_srv_name">k1_imu/get_dxl_data</param>
          <param name="set_dynamixel_data_srv_name">k1_imu/set_dxl_data</param>
          <param name="reboot_dxl_srv_name">k1_imu/reboot_dxl</param>
          <param name="set_dxl_torque_srv_name">k1_imu/set_dxl_torque</param>
        </xacro:unless>
      </hardware>

      <sensor name="imu">
        <state_interface name="linear_acceleration.x">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="linear_acceleration.y">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="linear_acceleration.z">
          <param name="initial_value">-9.80665</param>
        </state_interface>
        <state_interface name="angular_velocity.x">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="angular_velocity.y">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="angular_velocity.z">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="orientation.w">
          <param name="initial_value">1.0</param>
        </state_interface>
        <state_interface name="orientation.x">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="orientation.y">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="orientation.z">
          <param name="initial_value">0.0</param>
        </state_interface>
      </sensor>

      <xacro:unless value="${use_mock_hardware}">
        <gpio name="imu">
          <param name="type">sensor</param>
          <param name="ID">202</param>
          <state_interface name="linear_acceleration.x"/>
          <state_interface name="linear_acceleration.y"/>
          <state_interface name="linear_acceleration.z"/>
          <state_interface name="angular_velocity.x"/>
          <state_interface name="angular_velocity.y"/>
          <state_interface name="angular_velocity.z"/>
          <state_interface name="orientation.w"/>
          <state_interface name="orientation.x"/>
          <state_interface name="orientation.y"/>
          <state_interface name="orientation.z"/>
        </gpio>
      </xacro:unless>
    </ros2_control>
  </xacro:macro>
</robot>
