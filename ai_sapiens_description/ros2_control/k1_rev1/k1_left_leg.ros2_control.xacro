<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="k1_left_leg_system" params="use_mock_hardware:=^|false mock_sensor_commands:=^|false">
    <ros2_control name="k1_left_leg" type="system" is_async="true">
      <properties>
        <async scheduling_policy="synchronized" print_warnings="false"/>
      </properties>
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">${mock_sensor_commands}</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
          <param name="port_name">e2d2udp:192.168.10.1:5003</param>
          <param name="baud_rate">6000000</param>
          <param name="error_timeout_ms">500</param>
          <param name="optimized_sync_read_return_delay_us">0</param>
          <param name="optimized_sync_read_timeout_margin_us">-200</param>
          <param name="optimized_sync_read_rx_timeout_us">800</param>
          <param name="optimized_sync_read_period_us">1000</param>
          <param name="dynamixel_model_folder">/param/dxl_model</param>
          <param name="number_of_joints">6</param>
          <param name="number_of_transmissions">6</param>
          <param name="disable_torque_at_init">true</param>
          <param name="dynamixel_state_pub_msg_name">k1_left_leg/dxl_state</param>
          <param name="get_dynamixel_data_srv_name">k1_left_leg/get_dxl_data</param>
          <param name="set_dynamixel_data_srv_name">k1_left_leg/set_dxl_data</param>
          <param name="reboot_dxl_srv_name">k1_left_leg/reboot_dxl</param>
          <param name="set_dxl_torque_srv_name">k1_left_leg/set_dxl_torque</param>
        </xacro:unless>
      </hardware>

      <!-- Left leg joints -->
      <joint name="left_hip_pitch_joint">
        <command_interface name="position"/>
        <command_interface name="feedforward"/>
        <command_interface name="proportional"/>
        <command_interface name="derivative"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_hip_roll_joint">
        <command_interface name="position"/>
        <command_interface name="feedforward"/>
        <command_interface name="proportional"/>
        <command_interface name="derivative"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_hip_yaw_joint">
        <command_interface name="position"/>
        <command_interface name="feedforward"/>
        <command_interface name="proportional"/>
        <command_interface name="derivative"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_knee_joint">
        <command_interface name="position"/>
        <command_interface name="feedforward"/>
        <command_interface name="proportional"/>
        <command_interface name="derivative"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_ankle_pitch_joint">
        <command_interface name="position"/>
        <command_interface name="feedforward"/>
        <command_interface name="proportional"/>
        <command_interface name="derivative"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_ankle_roll_joint">
        <command_interface name="position"/>
        <command_interface name="feedforward"/>
        <command_interface name="proportional"/>
        <command_interface name="derivative"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <gpio name="dxl21">
        <param name="type">dxl</param>
        <param name="ID">21</param>
        <param name="Drive Mode">64</param>
        <param name="Operating Mode">6</param>
        <command_interface name="Goal Position"/>
        <command_interface name="Current Offset"/>
        <command_interface name="MIT P Gain"/>
        <command_interface name="MIT D Gain"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <state_interface name="Error Code"/>
        <param name="Return Delay Time">0</param>
        <param name="MIT P Gain">0</param>
        <param name="MIT D Gain">0</param>
        <param name="Torque Enable">1</param>
        <param name="Torque Constant">3211</param>
        <param name="Current Limit">9633</param>
      </gpio>
      <gpio name="dxl22">
        <param name="type">dxl</param>
        <param name="ID">22</param>
        <param name="Drive Mode">64</param>
        <param name="Operating Mode">6</param>
        <command_interface name="Goal Position"/>
        <command_interface name="Current Offset"/>
        <command_interface name="MIT P Gain"/>
        <command_interface name="MIT D Gain"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <state_interface name="Error Code"/>
        <param name="Return Delay Time">0</param>
        <param name="MIT P Gain">0</param>
        <param name="MIT D Gain">0</param>
        <param name="Torque Enable">1</param>
        <param name="Torque Constant">3211</param>
        <param name="Current Limit">9633</param>
      </gpio>
      <gpio name="dxl23">
        <param name="type">dxl</param>
        <param name="ID">23</param>
        <param name="Drive Mode">65</param>
        <param name="Operating Mode">6</param>
        <command_interface name="Goal Position"/>
        <command_interface name="Current Offset"/>
        <command_interface name="MIT P Gain"/>
        <command_interface name="MIT D Gain"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <state_interface name="Error Code"/>
        <param name="Return Delay Time">0</param>
        <param name="MIT P Gain">0</param>
        <param name="MIT D Gain">0</param>
        <param name="Torque Enable">1</param>
        <param name="Torque Constant">3211</param>
        <param name="Current Limit">9633</param>
      </gpio>
      <gpio name="dxl24">
        <param name="type">dxl</param>
        <param name="ID">24</param>
        <param name="Drive Mode">64</param>
        <param name="Operating Mode">6</param>
        <command_interface name="Goal Position"/>
        <command_interface name="Current Offset"/>
        <command_interface name="MIT P Gain"/>
        <command_interface name="MIT D Gain"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <state_interface name="Error Code"/>
        <param name="Return Delay Time">0</param>
        <param name="MIT P Gain">0</param>
        <param name="MIT D Gain">0</param>
        <param name="Torque Enable">1</param>
        <param name="Torque Constant">3211</param>
        <param name="Current Limit">9633</param>
      </gpio>
      <gpio name="dxl25">
        <param name="type">dxl</param>
        <param name="ID">25</param>
        <param name="Drive Mode">64</param>
        <param name="Operating Mode">6</param>
        <command_interface name="Goal Position"/>
        <command_interface name="Current Offset"/>
        <command_interface name="MIT P Gain"/>
        <command_interface name="MIT D Gain"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <state_interface name="Error Code"/>
        <param name="Return Delay Time">0</param>
        <param name="MIT P Gain">0</param>
        <param name="MIT D Gain">0</param>
        <param name="Torque Enable">1</param>
        <param name="Torque Constant">3211</param>
        <param name="Current Limit">9633</param>
      </gpio>
      <gpio name="dxl26">
        <param name="type">dxl</param>
        <param name="ID">26</param>
        <param name="Drive Mode">65</param>
        <param name="Operating Mode">6</param>
        <command_interface name="Goal Position"/>
        <command_interface name="Current Offset"/>
        <command_interface name="MIT P Gain"/>
        <command_interface name="MIT D Gain"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <state_interface name="Error Code"/>
        <param name="Return Delay Time">0</param>
        <param name="MIT P Gain">0</param>
        <param name="MIT D Gain">0</param>
        <param name="Torque Enable">1</param>
        <param name="Torque Constant">1653</param>
        <param name="Current Limit">4427</param>
      </gpio>
    </ros2_control>
  </xacro:macro>
</robot>
