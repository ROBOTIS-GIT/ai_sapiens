<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ai_sapiens_sim2real</name>
  <version>0.1.0</version>
  <description>Real-time ONNX inference for sim-to-real policy deployment with ros2_control integration</description>
  <maintainer email="pyo@robotis.com">Pyo</maintainer>
  <license>Apache-2.0</license>
  <author email="wwj@robotis.com">Woojin Wie</author>
  <author email="pkw@robotis.com">Kiwoong Park</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ai_sapiens_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>realtime_tools</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>control_msgs</depend>
  <depend>pluginlib</depend>

  <build_depend>yaml-cpp</build_depend>
  <build_depend>eigen</build_depend>

  <exec_depend>yaml-cpp</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
